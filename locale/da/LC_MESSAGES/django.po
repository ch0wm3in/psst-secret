msgstr "Side Ikke Fundet"

#: templates/404.html:9
msgid "Page not found"
msgstr "Side ikke fundet"

#: templates/404.html:10
msgid "The page you're looking for doesn't exist or may have been removed."
msgstr "Siden du leder efter eksisterer ikke, eller den er blevet flyttet."

#: templates/404.html:12
msgid "Go to homepage"
msgstr "Gå til hovedside"

#: templates/base/layout.html:12
msgid "Zero-knowledge secret sharing"
msgstr "Intet-kendskab hemmeligheds deling"

#: templates/base/layout.html:26 templates/whispers/about.html:4
msgid "About"
msgstr "Om"

#: templates/base/layout.html:46
msgid "Sign out"
msgstr "Log ud"

#: templates/base/layout.html:64
