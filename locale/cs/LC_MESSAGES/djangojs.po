#: static/js/crypto.js:108
msgid "Remove"
msgstr "Odstranit"

#: static/js/crypto.js:117
#, javascript-format
msgid "Total: %s / %s"
msgstr "Celkem: %s / %s"

#: static/js/crypto.js:122
#, javascript-format
msgid "Skipped (would exceed %s total): %s"
msgstr "Vynecháno (překročilo by celkový limit %s): %s"

#: static/js/crypto.js:304
msgid "Post-quantum crypto module failed to load."
msgstr "Nepodařilo se načíst modul postkvantové kryptografie."

#: static/js/crypto.js:345
msgid ""
"The request key does not match the link. The link may be incomplete or "
"tampered with."
msgstr ""
"Klíč žádosti neodpovídá odkazu. Odkaz může být neúplný nebo pozměněný."

#: static/js/crypto.js:427 static/js/crypto.js:674
msgid "Please enter some content or select a file to encrypt."
msgstr "Zadejte obsah nebo vyberte soubor k zašifrování."

#: static/js/crypto.js:433 static/js/crypto.js:680
#, javascript-format
msgid "Selected files exceed the maximum total size of %s."
msgstr "Vybrané soubory překračují maximální celkovou velikost %s."

#: static/js/crypto.js:439 static/js/crypto.js:686
msgid "Encrypting…"
msgstr "Šifrování…"

#: static/js/crypto.js:452 static/js/crypto.js:573
msgid ""
"Passphrase does not meet the strength requirements shown below the field."
msgstr "Heslo nesplňuje požadavky na sílu uvedené pod polem."

#: static/js/crypto.js:495 static/js/crypto.js:618 static/js/crypto.js:718
#, javascript-format
msgid "Server error (%s)"
msgstr "Chyba serveru (%s)"

#: static/js/crypto.js:516
msgid "This whisper will be destroyed after being viewed once."
msgstr "Tento whisper bude po jednom zobrazení smazán."

#: static/js/crypto.js:518
#, javascript-format
msgid "This whisper will be destroyed after %s views."
msgstr "Tento whisper bude smazán po dosažení tohoto počtu zobrazení: %s."

#: static/js/crypto.js:526 static/js/crypto.js:649 static/js/crypto.js:726
#, javascript-format
msgid "Error: %s"
msgstr "Chyba: %s"

#: static/js/crypto.js:530
msgid "Encrypt & Share"
msgstr "Zašifrovat a sdílet"

#: static/js/crypto.js:541
msgid "Copied!"
msgstr "Zkopírováno!"

#: static/js/crypto.js:542
msgid "Copy"
msgstr "Kopírovat"

#: static/js/crypto.js:560
msgid "Creating…"
msgstr "Vytváření…"

#: static/js/crypto.js:639
msgid "The whisper will be destroyed after you view it once."
msgstr "Whisper bude smazán, jakmile jej jednou zobrazíte."

#: static/js/crypto.js:641
#, javascript-format
msgid "The whisper will be destroyed after %s views."
msgstr "Whisper bude smazán po dosažení tohoto počtu zobrazení: %s."

#: static/js/crypto.js:653
msgid "Create Request"
msgstr "Vytvořit žádost"

#: static/js/crypto.js:690
msgid "No encryption key found in URL. The link may be incomplete."
msgstr "V URL nebyl nalezen šifrovací klíč. Odkaz může být neúplný."

#: static/js/crypto.js:730
msgid "Encrypt & Submit"
msgstr "Zašifrovat a odeslat"

#: static/js/receive-access.js:37
msgid "Saving…"
msgstr "Ukládání…"

#: static/js/receive-access.js:52 static/js/receive-access.js:54
#: static/js/receive-access.js:61
msgid "Could not update access."
msgstr "Přístup se nepodařilo aktualizovat."

#: static/js/receive-access.js:58
msgid "Access updated."
msgstr "Přístup byl aktualizován."

#: static/js/secret-generator.js:94
msgid "Secure random number generation is not available in this browser."
msgstr ""
"Bezpečné generování náhodných čísel není v tomto prohlížeči k dispozici."

#: static/js/secret-generator.js:206
msgid "Select at least one character type."
msgstr "Vyberte alespoň jeden typ znaků."

#: static/js/secret-generator.js:207
msgid "The minimum counts add up to more than the length."
msgstr "Součet minimálních počtů přesahuje délku."

#: static/js/secret-generator.js:208
msgid "The word list could not be loaded."
msgstr "Seznam slov se nepodařilo načíst."

#: static/js/secret-generator.js:431
msgid "Estimated strength: ≈ %(bits)s bits"
msgstr "Odhadovaná síla: ≈ %(bits)s bitů"
