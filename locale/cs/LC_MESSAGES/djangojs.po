#: static/js/crypto.js:130 static/js/receive-history.js:583
msgid "Remove"
msgstr "Odstranit"

#: static/js/crypto.js:139
#, javascript-format
msgid "Total: %s / %s"
msgstr "Celkem: %s / %s"

#: static/js/crypto.js:144
#, javascript-format
msgid "Skipped (would exceed %s total): %s"
msgstr "Vynecháno (překročilo by celkový limit %s): %s"

#: static/js/crypto.js:373
msgid "Post-quantum crypto module failed to load."
msgstr "Nepodařilo se načíst modul postkvantové kryptografie."

#: static/js/crypto.js:414
msgid ""
"The request key does not match the link. The link may be incomplete or "
"tampered with."
msgstr "Klíč žádosti neodpovídá odkazu. Odkaz může být neúplný nebo pozměněný."

#: static/js/crypto.js:496 static/js/crypto.js:765
msgid "Please enter some content or select a file to encrypt."
msgstr "Zadejte obsah nebo vyberte soubor k zašifrování."

#: static/js/crypto.js:502 static/js/crypto.js:771
#, javascript-format
msgid "Selected files exceed the maximum total size of %s."
msgstr "Vybrané soubory překračují maximální celkovou velikost %s."

#: static/js/crypto.js:508 static/js/crypto.js:777
msgid "Encrypting…"
msgstr "Šifrování…"

#: static/js/crypto.js:521 static/js/crypto.js:644
msgid ""
"Passphrase does not meet the strength requirements shown below the field."
msgstr "Heslo nesplňuje požadavky na sílu uvedené pod polem."

#: static/js/crypto.js:568 static/js/crypto.js:692 static/js/crypto.js:814
#, javascript-format
msgid "Server error (%s)"
msgstr "Chyba serveru (%s)"

#: static/js/crypto.js:586
msgid "This whisper will be destroyed after being viewed once."
msgstr "Tento whisper bude po jednom zobrazení smazán."

#: static/js/crypto.js:588
#, javascript-format
msgid "This whisper will be destroyed after %s views."
msgstr "Tento whisper bude smazán po dosažení tohoto počtu zobrazení: %s."

#: static/js/crypto.js:597 static/js/crypto.js:740 static/js/crypto.js:822
#, javascript-format
msgid "Error: %s"
msgstr "Chyba: %s"

#: static/js/crypto.js:601
msgid "Encrypt & Share"
msgstr "Zašifrovat a sdílet"

#: static/js/crypto.js:612 static/js/receive-history.js:364
msgid "Copied!"
msgstr "Zkopírováno!"

#: static/js/crypto.js:613
msgid "Copy"
msgstr "Kopírovat"

#: static/js/crypto.js:631
msgid "Creating…"
msgstr "Vytváření…"

#: static/js/crypto.js:729
msgid "The whisper will be destroyed after you view it once."
msgstr "Whisper bude smazán, jakmile jej jednou zobrazíte."

#: static/js/crypto.js:731
#, javascript-format
msgid "The whisper will be destroyed after %s views."
msgstr "Whisper bude smazán po dosažení tohoto počtu zobrazení: %s."

#: static/js/crypto.js:744
msgid "Create Request"
msgstr "Vytvořit žádost"

#: static/js/crypto.js:782
msgid "This link uses an unsupported format version. Ask for a new link."
msgstr "Odkaz používá nepodporovanou verzi formátu. Požádejte o nový odkaz."

#: static/js/crypto.js:785
msgid "No encryption key found in URL. The link may be incomplete."
msgstr "V URL nebyl nalezen šifrovací klíč. Odkaz může být neúplný."

#: static/js/crypto.js:826
msgid "Encrypt & Submit"
msgstr "Zašifrovat a odeslat"

#: static/js/receive-access.js:37
msgid "Saving…"
msgstr "Ukládání…"

#: static/js/receive-access.js:52 static/js/receive-access.js:54
#: static/js/receive-access.js:61
msgid "Could not update access."
msgstr "Přístup se nepodařilo aktualizovat."

#: static/js/receive-access.js:58
msgid "Access updated."
msgstr "Přístup byl aktualizován."

#: static/js/receive-history.js:289
msgid "Waiting for sender"
msgstr "Čeká na odesílatele"

#: static/js/receive-history.js:290
msgid "Ready to view"
msgstr "Připraveno k zobrazení"

#: static/js/receive-history.js:291
msgid "Viewed"
msgstr "Zobrazeno"

#: static/js/receive-history.js:292
msgid "Expired"
msgstr "Vypršelo"

#: static/js/receive-history.js:293
msgid "Burned"
msgstr "Smazáno"

#: static/js/receive-history.js:333
#, javascript-format
msgid "Expires %s"
msgstr "Vyprší %s"

#: static/js/receive-history.js:386
#, javascript-format
msgid ""
"Also delete the %s saved receive request from this browser? Choose Cancel to "
"keep it."
msgid_plural ""
"Also delete all %s saved receive requests from this browser? Choose Cancel "
"to keep them."
msgstr[0] ""
"Smazat z tohoto prohlížeče také %s uloženou žádost o přijetí? Zvolte Zrušit, "
"chcete-li ji ponechat."
msgstr[1] ""
"Smazat z tohoto prohlížeče také všechny %s uložené žádosti o přijetí? Zvolte "
"Zrušit, chcete-li je ponechat."
msgstr[2] ""
"Smazat z tohoto prohlížeče také všech %s uložených žádostí o přijetí? Zvolte "
"Zrušit, chcete-li je ponechat."

#: static/js/receive-history.js:447 static/js/receive-history.js:541
msgid "No label"
msgstr "Bez štítku"

#: static/js/receive-history.js:480
msgid ""
"Delete all saved receive requests from this browser? You will no longer be "
"able to open them from here."
msgstr ""
"Smazat z tohoto prohlížeče všechny uložené žádosti o přijetí? Poté je odtud "
"již nebude možné otevřít."

#: static/js/receive-history.js:507
msgid "Label"
msgstr "Štítek"

#: static/js/receive-history.js:508
msgid "e.g. AWS credentials from Bob"
msgstr "např. přihlašovací údaje AWS od Boba"

#: static/js/receive-history.js:511
msgid "Save"
msgstr "Uložit"

#: static/js/receive-history.js:514
msgid "Cancel"
msgstr "Zrušit"

#: static/js/receive-history.js:547
#, javascript-format
msgid "Created %s"
msgstr "Vytvořeno %s"

#: static/js/receive-history.js:552
#, javascript-format
msgid "%s view remaining"
msgid_plural "%s views remaining"
msgstr[0] "Zbývá %s zobrazení"
msgstr[1] "Zbývají %s zobrazení"
msgstr[2] "Zbývá %s zobrazení"

#: static/js/receive-history.js:556
msgid "Unlimited views"
msgstr "Neomezený počet zobrazení"

#: static/js/receive-history.js:559
msgid "Password-protected"
msgstr "Chráněno heslem"

#: static/js/receive-history.js:567
msgid "Submit link"
msgstr "Odkaz pro odeslání"

#: static/js/receive-history.js:569
msgid "Copy submit link"
msgstr "Kopírovat odkaz pro odeslání"

#: static/js/receive-history.js:574
msgid "View whisper"
msgstr "Zobrazit whisper"

#: static/js/receive-history.js:576
msgid "Edit label"
msgstr "Upravit štítek"

#: static/js/receive-history.js:607
msgid "No saved receive requests in this browser."
msgstr "V tomto prohlížeči nejsou žádné uložené žádosti o přijetí."

#: static/js/receive-history.js:608
msgid "No receive requests match this filter."
msgstr "Tomuto filtru neodpovídají žádné žádosti o přijetí."

#: static/js/rich-text.js:155
msgid "Whisper content"
msgstr "Obsah whisperu"

#: static/js/rich-text.js:166
#, javascript-format
msgid "%s character"
msgid_plural "%s characters"
msgstr[0] "%s znak"
msgstr[1] "%s znaky"
msgstr[2] "%s znaků"

#: static/js/secret-generator.js:94
msgid "Secure random number generation is not available in this browser."
msgstr ""
"Bezpečné generování náhodných čísel není v tomto prohlížeči k dispozici."

#: static/js/secret-generator.js:206
msgid "Select at least one character type."
msgstr "Vyberte alespoň jeden typ znaků."

#: static/js/secret-generator.js:207
msgid "The minimum counts add up to more than the length."
msgstr "Součet minimálních počtů přesahuje délku."

#: static/js/secret-generator.js:208
msgid "The word list could not be loaded."
msgstr "Seznam slov se nepodařilo načíst."

#: static/js/secret-generator.js:450
msgid "Estimated strength: ≈ %(bits)s bits"
msgstr "Odhadovaná síla: ≈ %(bits)s bitů"

