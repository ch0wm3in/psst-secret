#: whispers/deployment.py:45
msgid "username and password"
msgstr "användarnamn och lösenord"

#: whispers/deployment.py:48
#, python-format
msgid "Sign-in options: %(methods)s"
msgstr "Inloggningsalternativ: %(methods)s"

#: whispers/deployment.py:57 whispers/deployment.py:75
#: whispers/deployment.py:85 whispers/deployment.py:98
#: whispers/deployment.py:111
msgid "Sign-in"
msgstr "Inloggning"

#: whispers/deployment.py:58
msgid "Not used"
msgstr "Används inte"

#: whispers/deployment.py:61
msgid ""
"Anyone who can reach this site can create whispers. Viewing a whisper or "
"submitting to a request only needs the link."
msgstr ""
"Alla som kan nå den här webbplatsen kan skapa whispers. För att visa en "
"whisper eller skicka in till en begäran behövs bara länken."

#: whispers/deployment.py:76
msgid "Required"
msgstr "Krävs"

#: whispers/deployment.py:78
msgid "You must sign in to create whispers and requests."
msgstr "Du måste logga in för att skapa whispers och begäranden."

#: whispers/deployment.py:86 whispers/deployment.py:99
msgid "Partly required"
msgstr "Delvis krävs"

#: whispers/deployment.py:89
msgid ""
"You must sign in to create whispers, but you can create receive requests "
"without signing in."
msgstr ""
"Du måste logga in för att skapa whispers, men du kan skapa "
"mottagningsbegäranden utan att logga in."

#: whispers/deployment.py:102
msgid ""
"You can create whispers without signing in, but you must sign in to create "
"receive requests."
msgstr ""
"Du kan skapa whispers utan att logga in, men du måste logga in för att skapa "
"mottagningsbegäranden."

#: whispers/deployment.py:112 whispers/deployment.py:207
msgid "Optional"
msgstr "Valfritt"

#: whispers/deployment.py:114
msgid "You can create whispers without signing in."
msgstr "Du kan skapa whispers utan att logga in."

#: whispers/deployment.py:124 whispers/deployment.py:133
msgid "Viewing whispers"
msgstr "Visa whispers"

#: whispers/deployment.py:125 whispers/deployment.py:149
msgid "Sign-in required"
msgstr "Inloggning krävs"

#: whispers/deployment.py:127
msgid "You must sign in to view any whisper, in addition to having its link."
msgstr "Du måste logga in för att visa en whisper, utöver att ha dess länk."

#: whispers/deployment.py:134 whispers/deployment.py:158
msgid "Link only"
msgstr "Endast länk"

#: whispers/deployment.py:137
msgid ""
"Anyone with the full link can view a whisper without signing in, unless its "
"creator requires sign-in for that whisper."
msgstr ""
"Alla med den fullständiga länken kan visa en whisper utan att logga in, om "
"inte skaparen kräver inloggning för just den whispern."

#: whispers/deployment.py:148 whispers/deployment.py:157
msgid "Submitting to requests"
msgstr "Skicka in till begäranden"

#: whispers/deployment.py:151
msgid "You must sign in to submit a whisper to a receive request."
msgstr ""
"Du måste logga in för att skicka in en whisper till en mottagningsbegäran."

#: whispers/deployment.py:161
msgid ""
"Anyone with a submit link can submit a whisper without signing in, unless "
"the request's creator requires sign-in."
msgstr ""
"Alla med en inskickningslänk kan skicka in en whisper utan att logga in, om "
"inte begärans skapare kräver inloggning."

#: whispers/deployment.py:166
msgid "Restricted receive access"
msgstr "Begränsad läsåtkomst för mottagning"

#: whispers/deployment.py:172 whispers/deployment.py:241
#: whispers/deployment.py:268 whispers/deployment.py:295
msgid "Off"
msgstr "Av"

#: whispers/deployment.py:174
msgid "Receive requests cannot be limited to specific accounts."
msgstr "Mottagningsbegäranden kan inte begränsas till specifika konton."

#: whispers/deployment.py:181
msgid "Always on"
msgstr "Alltid på"

#: whispers/deployment.py:184
msgid ""
"New receive requests can only be read by their creator and the accounts they "
"approve, and creators cannot turn this off when changing access. Existing "
"requests keep their current access setting."
msgstr ""
"Nya mottagningsbegäranden kan bara läsas av sin skapare och de konton "
"skaparen godkänner, och skapare kan inte stänga av det när åtkomsten ändras. "
"Befintliga begäranden behåller sin nuvarande åtkomstinställning."

#: whispers/deployment.py:195
msgid "On by default"
msgstr "På som standard"

#: whispers/deployment.py:198
msgid ""
"New receive requests are limited to their creator and approved accounts "
"unless the creator turns this off."
msgstr ""
"Nya mottagningsbegäranden begränsas till sin skapare och godkända konton om "
"inte skaparen stänger av det."

#: whispers/deployment.py:210
msgid ""
"Creators can limit receive requests to themselves and the accounts they "
"approve."
msgstr ""
"Skapare kan begränsa mottagningsbegäranden till sig själva och de konton de "
"godkänner."

#: whispers/deployment.py:226 whispers/deployment.py:240
msgid "Email notifications"
msgstr "E-postaviseringar"

#: whispers/deployment.py:227
msgid "Available"
msgstr "Tillgänglig"

#: whispers/deployment.py:230
msgid ""
"You can have an email sent when a whisper is created or submitted. The email "
"never contains the decryption key."
msgstr ""
"Du kan få ett e-postmeddelande skickat när en whisper skapas eller skickas "
"in. E-postmeddelandet innehåller aldrig dekrypteringsnyckeln."

#: whispers/deployment.py:243
msgid "This site does not send email notifications."
msgstr "Den här webbplatsen skickar inga e-postaviseringar."

#: whispers/deployment.py:252 whispers/deployment.py:267
msgid "Usage statistics"
msgstr "Användningsstatistik"

#: whispers/deployment.py:253 whispers/deployment.py:280
msgid "On"
msgstr "På"

#: whispers/deployment.py:256
msgid ""
"Anonymous hourly counts of created and revealed whispers are kept for up to "
"a year. No content, keys, identifiers, IP addresses, or accounts are "
"recorded."
msgstr ""
"Anonyma antal per timme för skapade och visade whispers sparas i upp till "
"ett år. Inget innehåll och inga nycklar, identifierare, IP-adresser eller "
"konton registreras."

#: whispers/deployment.py:270
msgid "No usage statistics are collected."
msgstr "Ingen användningsstatistik samlas in."

#: whispers/deployment.py:279 whispers/deployment.py:294
msgid "Formatted text"
msgstr "Formaterad text"

#: whispers/deployment.py:283
msgid ""
"Whispers can use headings, lists, links, and code, written in a Markdown "
"editor, or be written as plain text. Formatting stays inside the encrypted "
"whisper."
msgstr ""
"Whispers kan innehålla rubriker, listor, länkar och kod, skrivna i en "
"Markdown-redigerare, eller skrivas som vanlig text. Formateringen stannar "
"inuti den krypterade whispern."

#: whispers/deployment.py:297
msgid "Whispers are written and shown as plain text."
msgstr "Whispers skrivs och visas som vanlig text."

#: whispers/deployment.py:305
msgid "File size limit"
msgstr "Gräns för filstorlek"

#: whispers/deployment.py:308
msgid "Maximum total size of the files attached to a single whisper."
msgstr "Största totala storlek på filerna som bifogas en enskild whisper."

#: whispers/deployment.py:317 whispers/deployment.py:331
msgid "Encrypted storage"
msgstr "Krypterad lagring"

#: whispers/deployment.py:318
msgid "Saved to disk"
msgstr "Sparas på disk"

#: whispers/deployment.py:321
msgid ""
"Encrypted whispers are stored in Redis with persistence enabled, so they "
"survive server restarts until they expire."
msgstr ""
"Krypterade whispers lagras i Redis med beständig lagring aktiverad, så de "
"överlever omstarter av servern tills de upphör att gälla."

#: whispers/deployment.py:332
msgid "Memory only"
msgstr "Endast i minnet"

#: whispers/deployment.py:335
msgid ""
"Encrypted whispers live only in memory and are lost if the server restarts."
msgstr ""
"Krypterade whispers finns bara i minnet och går förlorade om servern startas "
"om."

