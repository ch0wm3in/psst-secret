#: static/js/receive-history.js:386
#, javascript-format
msgid ""
"Also delete the %s saved receive request from this browser? Choose Cancel to "
"keep it."
msgid_plural ""
"Also delete all %s saved receive requests from this browser? Choose Cancel "
"to keep them."
msgstr[0] ""
"Ta också bort den %s sparade mottagningsförfrågan från den här webbläsaren? "
"Välj Avbryt för att behålla den."
msgstr[1] ""
"Ta också bort alla %s sparade mottagningsförfrågningar från den här "
"webbläsaren? Välj Avbryt för att behålla dem."

#: static/js/receive-history.js:447 static/js/receive-history.js:541
msgid "No label"
msgstr "Ingen etikett"

#: static/js/receive-history.js:480
msgid ""
"Delete all saved receive requests from this browser? You will no longer be "
"able to open them from here."
msgstr ""
"Ta bort alla sparade mottagningsförfrågningar från den här webbläsaren? Du "
"kan då inte längre öppna dem härifrån."

