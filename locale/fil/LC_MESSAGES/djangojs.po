#: static/js/crypto.js:127 static/js/receive-history.js:614
msgid "Remove"
msgstr "Alisin"

#: static/js/crypto.js:136
#, javascript-format
msgid "Total: %s / %s"
msgstr "Kabuuan: %s / %s"

#: static/js/crypto.js:141
#, javascript-format
msgid "Skipped (would exceed %s total): %s"
msgstr "Nilaktawan (lalampas sa %s na kabuuan): %s"

#: static/js/crypto.js:225 static/js/crypto.js:490
msgid "Please enter some content or select a file to encrypt."
msgstr "Maglagay ng nilalaman o pumili ng file na i-e-encrypt."

#: static/js/crypto.js:231 static/js/crypto.js:496
#, javascript-format
msgid "Selected files exceed the maximum total size of %s."
msgstr "Lumampas ang mga napiling file sa pinakamalaking kabuuang laki na %s."

#: static/js/crypto.js:237 static/js/crypto.js:502
msgid "Encrypting…"
msgstr "Ine-encrypt…"

#: static/js/crypto.js:250 static/js/crypto.js:369
msgid ""
"Passphrase does not meet the strength requirements shown below the field."
msgstr ""
"Hindi natutugunan ng password ang mga kinakailangan sa tibay na nakalista sa "
"ibaba ng field."

#: static/js/crypto.js:293 static/js/crypto.js:417 static/js/crypto.js:543
#, javascript-format
msgid "Server error (%s)"
msgstr "Error sa server (%s)"

#: static/js/crypto.js:311
msgid "This whisper will be destroyed after being viewed once."
msgstr "Buburahin ang whisper na ito pagkatapos tingnan nang isang beses."

#: static/js/crypto.js:313
#, javascript-format
msgid "This whisper will be destroyed after %s views."
msgstr "Buburahin ang whisper na ito pagkatapos ng %s pagtingin."

#: static/js/crypto.js:322 static/js/crypto.js:465 static/js/crypto.js:551
#, javascript-format
msgid "Error: %s"
msgstr "Error: %s"

#: static/js/crypto.js:326
msgid "Encrypt & Share"
msgstr "I-encrypt at ibahagi"

#: static/js/crypto.js:337 static/js/receive-history.js:380
msgid "Copied!"
msgstr "Nakopya na!"

#: static/js/crypto.js:338
msgid "Copy"
msgstr "Kopyahin"

#: static/js/crypto.js:356
msgid "Creating…"
msgstr "Lumilikha…"

#: static/js/crypto.js:454
msgid "The whisper will be destroyed after you view it once."
msgstr "Buburahin ang whisper pagkatapos mong tingnan nang isang beses."

#: static/js/crypto.js:456
#, javascript-format
msgid "The whisper will be destroyed after %s views."
msgstr "Buburahin ang whisper pagkatapos ng %s pagtingin."

#: static/js/crypto.js:469
msgid "Create Request"
msgstr "Lumikha ng kahilingan"

#: static/js/crypto.js:507
msgid "This link uses an unsupported format version. Ask for a new link."
msgstr ""
"Gumagamit ang link ng bersyon ng format na hindi suportado. Humingi ng "
"bagong link."

#: static/js/crypto.js:510
msgid "No encryption key found in URL. The link may be incomplete."
msgstr ""
"Walang susi para sa pag-encrypt sa URL. Maaaring hindi kumpleto ang link."

#: static/js/crypto.js:526
msgid ""
"The request key does not match the link. The link may be incomplete or "
"tampered with."
msgstr ""
"Hindi tumutugma ang susi ng kahilingan sa link. Maaaring hindi kumpleto o "
"napakialaman ang link."

#: static/js/crypto.js:555
msgid "Encrypt & Submit"
msgstr "I-encrypt at isumite"

#: static/js/receive-access.js:37
msgid "Saving…"
msgstr "Sine-save…"

#: static/js/receive-access.js:52 static/js/receive-access.js:54
#: static/js/receive-access.js:61
msgid "Could not update access."
msgstr "Hindi ma-update ang access."

#: static/js/receive-access.js:58
msgid "Access updated."
msgstr "Na-update ang access."

#: static/js/receive-history.js:305
msgid "Waiting for sender"
msgstr "Naghihintay sa nagpadala"

#: static/js/receive-history.js:306
msgid "Ready to view"
msgstr "Handa nang tingnan"

#: static/js/receive-history.js:307
msgid "Viewed"
msgstr "Natingnan na"

#: static/js/receive-history.js:308
msgid "Expired"
msgstr "Nag-expire na"

#: static/js/receive-history.js:309
msgid "Burned"
msgstr "Nabura na"

#: static/js/receive-history.js:349
#, javascript-format
msgid "Expires %s"
msgstr "Mag-e-expire %s"

#: static/js/receive-history.js:407
#, javascript-format
msgid ""
"Also delete the %s saved receive request from this browser? Choose Cancel to "
"keep it."
msgid_plural ""
"Also delete all %s saved receive requests from this browser? Choose Cancel "
"to keep them."
msgstr[0] ""
"Burahin din sa browser na ito ang %s naka-save na kahilingan sa pagtanggap? "
"Piliin ang Kanselahin para itago ito."
msgstr[1] ""
"Burahin din sa browser na ito ang lahat ng %s naka-save na kahilingan sa "
"pagtanggap? Piliin ang Kanselahin para itago ang mga ito."

#: static/js/receive-history.js:473 static/js/receive-history.js:572
msgid "No label"
msgstr "Walang label"

#: static/js/receive-history.js:507
msgid ""
"Delete all saved receive requests from this browser? You will no longer be "
"able to open them from here."
msgstr ""
"Burahin sa browser na ito ang lahat ng naka-save na kahilingan sa "
"pagtanggap? Hindi mo na mabubuksan ang mga ito mula rito."

#: static/js/receive-history.js:540
msgid "Label"
msgstr "Label"

#: static/js/receive-history.js:541
msgid "e.g. AWS credentials from Bob"
msgstr "hal. AWS credentials mula kay Bob"

#: static/js/receive-history.js:544
msgid "Save"
msgstr "I-save"

#: static/js/receive-history.js:547
msgid "Cancel"
msgstr "Kanselahin"

#: static/js/receive-history.js:578
#, javascript-format
msgid "Created %s"
msgstr "Ginawa noong %s"

#: static/js/receive-history.js:583
#, javascript-format
msgid "%s view remaining"
msgid_plural "%s views remaining"
msgstr[0] "%s pagtingin na lang ang natitira"
msgstr[1] "%s pagtingin na lang ang natitira"

#: static/js/receive-history.js:587
msgid "Unlimited views"
msgstr "Walang limitasyong pagtingin"

#: static/js/receive-history.js:590
msgid "Password-protected"
msgstr "Protektado ng password"

#: static/js/receive-history.js:598
msgid "Submit link"
msgstr "Link para sa pagsusumite"

#: static/js/receive-history.js:600
msgid "Copy submit link"
msgstr "Kopyahin ang link para sa pagsusumite"

#: static/js/receive-history.js:605
msgid "View whisper"
msgstr "Tingnan ang whisper"

#: static/js/receive-history.js:607
msgid "Edit label"
msgstr "I-edit ang label"

#: static/js/receive-history.js:638
msgid "No saved receive requests in this browser."
msgstr "Walang naka-save na kahilingan sa pagtanggap sa browser na ito."

#: static/js/receive-history.js:639
msgid "No receive requests match this filter."
msgstr "Walang kahilingan sa pagtanggap na tumutugma sa filter na ito."

#: static/js/rich-text.js:155
msgid "Whisper content"
msgstr "Nilalaman ng whisper"

#: static/js/rich-text.js:166
#, javascript-format
msgid "%s character"
msgid_plural "%s characters"
msgstr[0] "%s karakter"
msgstr[1] "%s karakter"

#: static/js/secret-generator.js:94
msgid "Secure random number generation is not available in this browser."
msgstr ""
"Hindi available sa browser na ito ang ligtas na pagbuo ng random na numero."

#: static/js/secret-generator.js:206
msgid "Select at least one character type."
msgstr "Pumili ng kahit isang uri ng karakter."

#: static/js/secret-generator.js:207
msgid "The minimum counts add up to more than the length."
msgstr "Lumalampas sa haba ang kabuuan ng mga pinakamababang bilang."

#: static/js/secret-generator.js:208
msgid "The word list could not be loaded."
msgstr "Hindi ma-load ang listahan ng salita."

#: static/js/secret-generator.js:450
msgid "Estimated strength: ≈ %(bits)s bits"
msgstr "Tinatayang lakas: ≈ %(bits)s bits"

