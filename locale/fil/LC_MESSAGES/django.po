msgstr ""
"Dapat na loopback address ang redirect address, gaya ng http://127.0.0.1:"
"<port>/callback o http://[::1]:<port>/callback, o isang browser extension "
"address na pinapayagan ng server na ito."

#: whispers/api_tokens.py:143
msgid "Unsupported response type."
msgstr "Hindi suportado ang uri ng response."

#: whispers/api_tokens.py:149
msgid "The client must use the S256 code challenge method."
msgstr "Dapat gamitin ng client ang S256 na paraan ng code challenge."

#: whispers/api_tokens.py:153
msgid "The code challenge is missing or invalid."
msgstr "Nawawala o hindi wasto ang code challenge."

#: whispers/api_tokens.py:156
msgid "The state parameter is missing or invalid."
msgstr "Nawawala o hindi wasto ang state parameter."

#: whispers/api_tokens.py:159
msgid "The client name is invalid."
msgstr "Hindi wasto ang pangalan ng client."

#: whispers/api_tokens.py:162
msgid "The client requested an unknown scope."
msgstr "Humiling ang client ng hindi kilalang scope."

#: whispers/api_tokens.py:202
msgid "The authorization code is invalid or expired."
msgstr "Hindi wasto o expired na ang authorization code."

#: whispers/api_tokens.py:255
msgid "The code verifier is missing or invalid."
msgstr "Nawawala o hindi wasto ang code verifier."

#: whispers/api_tokens.py:315
msgid "This token does not have the required scope."
msgstr "Walang kinakailangang scope ang token na ito."

#: whispers/deployment.py:45
msgid "username and password"
msgstr "username at password"

#: whispers/deployment.py:48
#, python-format
msgid "Sign-in options: %(methods)s"
msgstr "Mga opsyon sa pag-sign in: %(methods)s"

#: whispers/deployment.py:57 whispers/deployment.py:75
#: whispers/deployment.py:85 whispers/deployment.py:98
#: whispers/deployment.py:111
msgid "Sign-in"
msgstr "Pag-sign in"

#: whispers/deployment.py:58
msgid "Not used"
msgstr "Hindi ginagamit"

#: whispers/deployment.py:61
msgid ""
"Anyone who can reach this site can create whispers. Viewing a whisper or "
"submitting to a request only needs the link."
msgstr ""
"Sinumang makaka-access sa site na ito ay makakagawa ng mga whisper. Ang link "
"lamang ang kailangan para tumingin ng whisper o magsumite sa isang request."

#: whispers/deployment.py:76
msgid "Required"
msgstr "Kailangan"

#: whispers/deployment.py:78
msgid "You must sign in to create whispers and requests."
msgstr "Kailangan mong mag-sign in para gumawa ng mga whisper at request."

#: whispers/deployment.py:86 whispers/deployment.py:99
msgid "Partly required"
msgstr "Bahagyang kailangan"

#: whispers/deployment.py:89
msgid ""
"You must sign in to create whispers, but you can create receive requests "
"without signing in."
msgstr ""
"Kailangan mong mag-sign in para gumawa ng mga whisper, pero maaari kang "
"gumawa ng mga receive request nang hindi nagsa-sign in."

#: whispers/deployment.py:102
msgid ""
"You can create whispers without signing in, but you must sign in to create "
"receive requests."
msgstr ""
"Maaari kang gumawa ng mga whisper nang hindi nagsa-sign in, pero kailangan "
"mong mag-sign in para gumawa ng mga receive request."

#: whispers/deployment.py:112 whispers/deployment.py:207
#: whispers/deployment.py:330
msgid "Optional"
msgstr "Opsyonal"

#: whispers/deployment.py:114
msgid "You can create whispers without signing in."
msgstr "Maaari kang gumawa ng mga whisper nang hindi nagsa-sign in."

#: whispers/deployment.py:124 whispers/deployment.py:133
msgid "Viewing whispers"
msgstr "Pagtingin ng mga whisper"

#: whispers/deployment.py:125 whispers/deployment.py:149
msgid "Sign-in required"
msgstr "Kailangang mag-sign in"

#: whispers/deployment.py:127
msgid "You must sign in to view any whisper, in addition to having its link."
msgstr ""
"Kailangan mong mag-sign in para tumingin ng anumang whisper, bukod pa sa "
"pagkakaroon ng link nito."

#: whispers/deployment.py:134 whispers/deployment.py:158
msgid "Link only"
msgstr "Link lamang"

#: whispers/deployment.py:137
msgid ""
"Anyone with the full link can view a whisper without signing in, unless its "
"creator requires sign-in for that whisper."
msgstr ""
"Sinumang may buong link ay makakatingin ng whisper nang hindi nagsa-sign in, "
"maliban kung hinihingi ng gumawa nito ang pag-sign in para sa whisper na "
"iyon."

#: whispers/deployment.py:148 whispers/deployment.py:157
msgid "Submitting to requests"
msgstr "Pagsusumite sa mga request"

#: whispers/deployment.py:151
msgid "You must sign in to submit a whisper to a receive request."
msgstr ""
"Kailangan mong mag-sign in para magsumite ng whisper sa isang receive "
"request."

#: whispers/deployment.py:161
msgid ""
"Anyone with a submit link can submit a whisper without signing in, unless "
"the request's creator requires sign-in."
msgstr ""
"Sinumang may submit link ay makakapagsumite ng whisper nang hindi nagsa-sign "
"in, maliban kung hinihingi ng gumawa ng request ang pag-sign in."

#: whispers/deployment.py:166
msgid "Restricted receive access"
msgstr "Limitadong access sa pagtanggap"

#: whispers/deployment.py:172 whispers/deployment.py:233
#: whispers/deployment.py:264 whispers/deployment.py:291
#: whispers/deployment.py:318 whispers/deployment.py:346
msgid "Off"
msgstr "Naka-off"

#: whispers/deployment.py:174
msgid "Receive requests cannot be limited to specific accounts."
msgstr ""
"Hindi maaaring limitahan ang mga receive request sa mga partikular na "
"account."

#: whispers/deployment.py:181
msgid "Always on"
msgstr "Laging naka-on"

#: whispers/deployment.py:184
msgid ""
"New receive requests can only be read by their creator and the accounts they "
"approve, and creators cannot turn this off when changing access. Existing "
"requests keep their current access setting."
msgstr ""
"Ang mga bagong receive request ay mababasa lamang ng gumawa nito at ng mga "
"account na inaprubahan nito, at hindi ito maaaring i-off ng gumawa kapag "
"binabago ang access. Pinapanatili ng mga umiiral na request ang kanilang "
"kasalukuyang setting ng access."

#: whispers/deployment.py:195
msgid "On by default"
msgstr "Naka-on bilang default"

#: whispers/deployment.py:198
msgid ""
"New receive requests are limited to their creator and approved accounts "
"unless the creator turns this off."
msgstr ""
"Ang mga bagong receive request ay limitado sa gumawa nito at sa mga "
"aprubadong account maliban kung i-off ito ng gumawa."

#: whispers/deployment.py:210
msgid ""
"Creators can limit receive requests to themselves and the accounts they "
"approve."
msgstr ""
"Maaaring limitahan ng mga gumawa ang mga receive request sa kanilang sarili "
"at sa mga account na inaprubahan nila."

#: whispers/deployment.py:219 whispers/deployment.py:232
msgid "Command-line sign-in"
msgstr "Pag-sign in mula sa command line"

#: whispers/deployment.py:220 whispers/deployment.py:250
msgid "Available"
msgstr "Available"

#: whispers/deployment.py:223
msgid ""
"Programs such as the command-line tool can sign in through this site after "
"you approve them, and get a token that expires. You can revoke these tokens "
"from your account menu."
msgstr ""
"Maaaring mag-sign in sa site na ito ang mga program tulad ng command-line "
"tool pagkatapos mo silang aprubahan, at makakakuha sila ng token na nag-e-"
"expire. Maaari mong bawiin ang mga token na ito mula sa menu ng iyong "
"account."

#: whispers/deployment.py:235
msgid "Programs such as the command-line tool cannot sign in to this site."
msgstr ""
"Hindi makakapag-sign in sa site na ito ang mga program tulad ng command-line "
"tool."

#: whispers/deployment.py:249 whispers/deployment.py:263
msgid "Email notifications"
msgstr "Mga abiso sa email"

#: whispers/deployment.py:253
msgid ""
"You can have an email sent when a whisper is created or submitted. The email "
"never contains the decryption key."
msgstr ""
"Maaari kang magpadala ng email kapag may whisper na ginawa o isinumite. "
"Hindi kailanman naglalaman ang email ng decryption key."

#: whispers/deployment.py:266
msgid "This site does not send email notifications."
msgstr "Hindi nagpapadala ang site na ito ng mga abiso sa email."

#: whispers/deployment.py:275 whispers/deployment.py:290
msgid "Usage statistics"
msgstr "Estadistika ng paggamit"

#: whispers/deployment.py:276 whispers/deployment.py:303
msgid "On"
msgstr "Naka-on"

#: whispers/deployment.py:279
msgid ""
"Anonymous hourly counts of created and revealed whispers are kept for up to "
"a year. No content, keys, identifiers, IP addresses, or accounts are "
"recorded."
msgstr ""
"Itinatago nang hanggang isang taon ang mga anonimong bilang kada oras ng mga "
"ginawa at ipinakitang whisper. Walang nilalaman, key, identifier, IP "
"address, o account na itinatala."

#: whispers/deployment.py:293
msgid "No usage statistics are collected."
msgstr "Walang kinokolektang estadistika ng paggamit."

#: whispers/deployment.py:302 whispers/deployment.py:317
msgid "Formatted text"
msgstr "Naka-format na teksto"

#: whispers/deployment.py:306
msgid ""
"Whispers can use headings, lists, links, and code, written in a Markdown "
"editor, or be written as plain text. Formatting stays inside the encrypted "
"whisper."
msgstr ""
"Maaaring gumamit ang mga whisper ng mga heading, listahan, link, at code na "
"isinulat sa isang Markdown editor, o isulat bilang payak na teksto. "
"Nananatili ang pag-format sa loob ng naka-encrypt na whisper."

#: whispers/deployment.py:320
msgid "Whispers are written and shown as plain text."
msgstr "Isinusulat at ipinapakita ang mga whisper bilang payak na teksto."

#: whispers/deployment.py:333
msgid ""
"You can choose to keep your receive requests, with their view links and "
"labels, in this browser. Anyone with access to the browser profile can then "
"open those whispers. Nothing extra is sent to the server."
msgstr ""
"Maaari mong piliing itago sa browser na ito ang iyong mga kahilingan sa "
"pagtanggap, kasama ang mga link para sa pagtingin at mga label. Mabubuksan "
"ng sinumang may access sa browser profile ang mga whisper na iyon. Walang "
"karagdagang ipinapadala sa server."

#: whispers/deployment.py:349
msgid ""
"Receive requests are not saved in your browser. Keep the view link somewhere "
"safe yourself."
msgstr ""
"Hindi sine-save sa iyong browser ang mga kahilingan sa pagtanggap. Ikaw "
"mismo ang magtago ng link para sa pagtingin sa ligtas na lugar."

#: whispers/deployment.py:359
msgid "File size limit"
msgstr "Limitasyon sa laki ng file"

#: whispers/deployment.py:362
msgid "Maximum total size of the files attached to a single whisper."
msgstr ""
"Pinakamalaking kabuuang laki ng mga file na nakalakip sa iisang whisper."

#: whispers/deployment.py:371 whispers/deployment.py:385
msgid "Encrypted storage"
msgstr "Naka-encrypt na imbakan"

#: whispers/deployment.py:372
msgid "Saved to disk"
msgstr "Naka-save sa disk"

#: whispers/deployment.py:375
msgid ""
"Encrypted whispers are stored in Redis with persistence enabled, so they "
"survive server restarts until they expire."
msgstr ""
"Iniimbak ang mga naka-encrypt na whisper sa Redis na may persistence, kaya "
"nananatili ang mga ito kahit mag-restart ang server hanggang sa mag-expire."

#: whispers/deployment.py:386
msgid "Memory only"
msgstr "Sa memory lamang"

#: whispers/deployment.py:389
msgid ""
"Encrypted whispers live only in memory and are lost if the server restarts."
msgstr ""
"Nasa memory lamang ang mga naka-encrypt na whisper at mawawala kapag nag-"
"restart ang server."

#: whispers/middleware.py:68
msgid "Authentication required"
msgstr "Kailangang mag-sign in"

#: whispers/middleware.py:102
msgid "The API token is invalid, expired or revoked."
msgstr "Hindi wasto, expired, o binawi na ang API token."

#: whispers/stats.py:92
msgid "Monday"
msgstr "Lunes"

#: whispers/stats.py:93
msgid "Tuesday"
msgstr "Martes"

#: whispers/stats.py:94
msgid "Wednesday"
msgstr "Miyerkules"

#: whispers/stats.py:95
msgid "Thursday"
msgstr "Huwebes"

#: whispers/stats.py:96
msgid "Friday"
msgstr "Biyernes"

#: whispers/stats.py:97
msgid "Saturday"
msgstr "Sabado"

#: whispers/stats.py:98
msgid "Sunday"
msgstr "Linggo"

#: whispers/stats.py:118
msgid "5 minutes"
msgstr "5 minuto"

#: whispers/stats.py:119
msgid "1 hour"
msgstr "1 oras"

#: whispers/token_views.py:131
msgid "You denied access."
msgstr "Tinanggihan mo ang access."

#: whispers/token_views.py:228
msgid "Send the API token to revoke in the Authorization header."
msgstr "Ipadala sa Authorization header ang API token na babawiin."

#: whispers/views.py:75
msgid "Whisper storage is temporarily unavailable. Please try again later."
msgstr ""
"Pansamantalang hindi available ang storage ng whisper. Pakisubukang muli "
"mamaya."

#: whispers/views.py:206 whispers/views.py:864 whispers/views.py:969
msgid "Enter the verified primary email of each additional reader."
msgstr ""
"Ilagay ang beripikadong pangunahing email ng bawat karagdagang mambabasa."

#: whispers/views.py:847
msgid "Receive reader restrictions are not enabled."
msgstr "Hindi naka-enable ang mga limitasyon sa mambabasa sa pagtanggap."

#: whispers/views.py:851
msgid "Sign in to manage reader access."
msgstr "Mag-sign in upang pamahalaan ang access ng mambabasa."

#: whispers/views.py:855 whispers/views.py:960
msgid "Enable restricted access before adding readers."
msgstr "I-enable ang limitadong access bago magdagdag ng mga mambabasa."

