{
  "name": "theme",
  "version": "4.5.0",
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind && npm run build:alpine && npm run build:pqc && npm run build:tiptap && npm run build:custom && npm run build:icons",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "build:alpine": "node ./build-alpine.mjs",
    "build:pqc": "node ./build-pqc.mjs",
    "build:tiptap": "node ./build-tiptap.mjs",
    "build:custom": "node ./build-custom.mjs",
    "build:icons": "node ./build-icons.mjs",
    "dev": "npm run build:alpine && npm run build:pqc && npm run build:tiptap && npm run build:custom && npm run build:icons && cross-env NODE_ENV=development tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css -w"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "alpinejs": "^3.15.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "cross-env": "^7.0.3",
    "esbuild": "0.28.2",
    "heroicons": "2.2.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  }
}
